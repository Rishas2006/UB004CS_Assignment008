# =====================================================================
# RH HMS backend - copy this file to ".env" for local work.  NEVER commit ".env" or paste real keys into this example file.
# On Vercel the same names are entered under Project > Settings > Environment Variables.
# =====================================================================
NODE_ENV=development
PORT=4000

# ---- Database: PostgreSQL on Supabase --------------------------------
# Supabase dashboard > Connect > "Transaction pooler" (port 6543). Use THIS one on Vercel (serverless).
# Replace [YOUR-PASSWORD]; if the password has special characters (@ / # : ?) URL-encode them (@ = %40).
DATABASE_URL=postgresql://postgres.lghjouxqgivfaujrnrjk:Risvika2006RH@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# One-time table setup (npm run db:setup): Supabase "Session pooler" string (port 5432). If empty, DATABASE_URL is used.
DATABASE_URL_SETUP=postgresql://postgres.lghjouxqgivfaujrnrjk:Risvika2006RH@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# SSL is automatic (on for Supabase, off for localhost). Set false only for a local PostgreSQL that has no SSL.
# DB_SSL=false
# Local PostgreSQL without DATABASE_URL:  DB_HOST=localhost  DB_PORT=5432  DB_USER=postgres  DB_PASSWORD=...  DB_NAME=rh_hms

# ---- Auth - generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TTL=15m
REFRESH_DAYS=7

# ---- Frontend (CORS + links + PayHere return URLs) ----------------------
# Local: http://localhost:3000     Production: your Vercel FRONTEND domain, e.g. https://rh-hospital.vercel.app (no trailing slash)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Gmail (OTP, booking confirmation, reminders) -----------------------
# 1) Google Account > Security > turn ON 2-Step Verification   2) Security > App passwords > create one (16 letters)
# 3) SMTP_PASS = that App Password (NOT your normal Gmail password). Spaces are ignored. Gmail allows roughly 500 mails/day.
# Leave SMTP_HOST empty in development to print the e-mails in the terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=risvikamohanraj@gmail.com
SMTP_PASS=xwhf ulnj zvgi uvak
MAIL_FROM=risvikamohanraj@gmail.com

# ---- PayHere ------------------------------------------------------------
# Sandbox account: https://sandbox.payhere.lk  > Settings > Domains & Credentials > Add Domain/App.
# The Merchant Secret belongs to ONE domain: create a domain entry for localhost (127.0.0.1:3000) and another for your Vercel frontend domain.
# PAYHERE_SANDBOX=true = test cards, no real money.  false = LIVE (needs an approved live merchant account).
PAYHERE_MERCHANT_ID=1239523
PAYHERE_MERCHANT_SECRET=MjkwMDAwOTcwNDgwNzA5OTg0MzEwNzk2MDk1MzExNTg3NDc4NzE=
PAYHERE_SANDBOX=true
# Public HTTPS address of THIS API (PayHere calls /api/v1/billing/payhere/notify). Local: leave http://localhost:4000 (online payment is then disabled).
# Vercel: the backend PRODUCTION domain, e.g. https://rh-hms-api.vercel.app
PUBLIC_API_URL=http://localhost:4000

# ---- Vercel Cron ---------------------------------------------------------
# Any long random text. Vercel sends it automatically to /api/cron/* so nobody else can start the jobs.
CRON_SECRET=

# ---- AI Doc (optional). Without a key the rule-based fallback answers. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ---- Seed passwords (sample data only - change them for any public demo) ---
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STAFF_PASSWORD=Staff@12345
