{
  "name": "rh-hospital-backend",
  "version": "1.0.0",
  "description": "RH Hospital Management System - REST API (Node.js, Express, PostgreSQL / Supabase)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:schema": "node db/setup.js",
    "db:reset": "node db/setup.js --reset",
    "db:seed": "node db/seed.js",
    "db:setup": "node db/setup.js && node db/seed.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "mail:test": "node scripts/mail-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
