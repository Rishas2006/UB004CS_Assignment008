{
  "crons": [
    {
      "path": "/api/v1/cron/send-reminders",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/v1/cron/daily-summary",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/v1/cron/mark-no-shows",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/v1/cron/cleanup",
      "schedule": "0 3 * * 0"
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}