# ---- Backend connection ------------------------------------------------
# Production (Vercel): browser -> this site -> API (same origin, cookies work everywhere)
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_URL=https://your-api-project.vercel.app
# Local development instead (API on your PC): NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1  and leave BACKEND_URL empty

# ---- AI Doc / AI chat + symptom checker (server only, never NEXT_PUBLIC) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

